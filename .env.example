# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=replace_with_random_at_least_32_characters
SERVER_ENCRYPTION_KEY=replace_with_64_hex_characters
DATABASE_PATH=./data/companion.sqlite
PUBLIC_BASE_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=
ROSTER_PATH=
# Production example: PUBLIC_BASE_URL=https://coms.kw.ac.kr/companion
